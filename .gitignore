# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
# Playwright's traces and screenshots of a failed browser test.
test-results/
playwright-report/

# Local state
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3
.env
.env.*
!.env.example
.envrc
*.pem
*.key
# A Library's skills and local mode's own folder, if run from a checkout:
# `aistack export` writes ./aistack-library, and AISTACK_HOME may point here.
aistack-library/
.aistack/

# Agent tooling
# Claude Code's local state, except the project skills it shares with .agents/skills, and
# the settings and session-start hook every cloud session uses.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
.codex/
.overnight/

# Editors / OS
.DS_Store
.idea/
.vscode/
.serena/

# Design explorations: screenshots and throwaway copies of the page, never shipped.
design-variants/
