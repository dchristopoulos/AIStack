# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
# Playwright's traces and screenshots of a failed browser test.
test-results/
playwright-report/

# Local state
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3
.env
.env.*
!.env.example
.envrc
*.pem
*.key
# A Library's skills and local mode's own folder, if run from a checkout:
# `aistack export` writes ./aistack-library, and AISTACK_HOME may point here.
aistack-library/
.aistack/

# Coding-agent tooling: per-developer state stays local. Only the shared project skills,
# settings and development-environment hook under .claude/ are tracked.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
CLAUDE.local.md
AGENTS.override.md
.codex/
.cursor/
.gemini/
.kimi-code/
.opencode/
.windsurf/
.aider*
.overnight/

# Editors / OS
.DS_Store
.idea/
.vscode/
.serena/

# Design explorations: screenshots and throwaway copies of the page, never shipped.
design-variants/
