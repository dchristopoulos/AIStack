# Copy to .env and adjust. Never commit .env.

# Database. Defaults to a SQLite file in the container volume.
# Set a postgresql+asyncpg:// URL to use Postgres instead (ADR-0002).
DATABASE_URL=sqlite+aiosqlite:///./aistack.db

# Team invite code. New users redeem this once to register (ADR-0003).
# Generate your own before exposing the server.
AISTACK_INVITE_CODE=change-me

# Where the MCP server listens.
AISTACK_HOST=0.0.0.0
AISTACK_PORT=8000
