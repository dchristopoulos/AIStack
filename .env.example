# Copy to .env and adjust. Never commit .env.

# Database. Defaults to a SQLite file in the container volume.
# Set a postgresql+psycopg:// URL to use Postgres instead (ADR-0002).
# Drivers are synchronous by design: see ADR-0005.
DATABASE_URL=sqlite:///./aistack.db

# Team invite code. Presented as a bootstrap bearer token by new users (ADR-0003).
# Generate your own before exposing the server: the server refuses to start on this
# placeholder, or on anything shorter than 16 characters. Never printed, never logged.
AISTACK_INVITE_CODE=change-me

# Where the MCP server listens.
AISTACK_HOST=0.0.0.0
AISTACK_PORT=8000
AISTACK_MCP_PATH=/mcp

# The address clients reach this server at. Set it behind a reverse proxy: the server
# hands out URLs (the add_machine command, skill transfer links) and cannot see its own
# public address through one. Unset, each URL is built from the request that asked for it.
# AISTACK_PUBLIC_URL=https://aistack.example.com

# DEBUG, INFO, WARNING, ERROR, or CRITICAL.
AISTACK_LOG_LEVEL=INFO
